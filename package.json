{
  "name": "policy-sales-portal",
  "private": true,
  "version": "0.0.1",
  "description": "UAE Policy Sales Portal — one engine, five skins (see CLAUDE.md and docs/requirements)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "check:pan": "node scripts/check-pan-patterns.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "gen:config-register": "pnpm --filter @psp/api build && node apps/api/dist/rules/config-register-cli.js docs/build/CONFIG-REGISTER.md",
    "gen:traceability": "pnpm --filter @psp/api build && node apps/api/dist/uat/traceability-cli.js uat/matrix/TRACEABILITY.md .",
    "demo": "pnpm --filter @psp/api demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
